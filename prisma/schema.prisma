// Pleasant — shift scheduling and payroll for UK healthcare agencies.
// Multi-tenant: every operational row is scoped to an Agency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ClientStatus {
  ACTIVE
  PAUSED
  DISCHARGED
}

enum ShiftStatus {
  DRAFT
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  UNATTENDED
}

enum ShiftRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ShiftOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
  DISPUTED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  FINALISED
  PAID
}

enum AddonKey {
  GATEWAY
  PEAK
}

enum LineType {
  EARNING
  DEDUCTION
  EMPLOYER_COST
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PayBasis {
  HOURLY
  SALARY
}

model Agency {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  phone       String?
  email       String?
  address     String?
  postcode    String?
  payrollRef  String? // HMRC PAYE reference, e.g. 123/AB456
  companyNo   String? // Companies House number, printed on invoices
  vatNumber   String? // VAT registration number, printed on invoices
  invoiceEmail String? // default from-address for outgoing invoices

  // BACS originator identity, used on the STD18 payment file.
  bankSortCode   String?
  bankAccount    String?
  bankAccountName String?

  // Pay cycle (Local Care Force style: weekly, Monday 4pm cutoff, Friday pay).
  payFrequency  String @default("WEEKLY") // WEEKLY | FORTNIGHTLY | FOUR_WEEKLY | MONTHLY
  cutoffWeekday Int    @default(1) // 0 = Sunday … 6 = Saturday (1 = Monday)
  cutoffTime    String @default("16:00") // 24h "HH:MM"
  payWeekday    Int    @default(5) // 5 = Friday
  roundingMins  Int    @default(15) // hours rounded to nearest quarter hour

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  staff       StaffProfile[]
  clients     Client[]
  sites       Site[]
  shifts      Shift[]
  timesheets  Timesheet[]
  payrollRuns PayrollRun[]
  shiftRequests ShiftRequest[]

  shiftComments ShiftComment[]
  staffDocuments StaffDocument[]
  pushLogs PushMessageLog[]
  pleasantLinkTokens PleasantLinkToken[]
  clientComplaints ClientComplaint[]
  confidenceRatings ClientConfidenceRating[]
  agentTasks AgentTask[]
  agentLogs AgentLog[]
  pushbotCampaigns PushbotCampaign[]
  rightToWorks RightToWork[]
  trainingRecords TrainingRecord[]
  onboardingForms OnboardingForm[]

  invoices    Invoice[]
  rotaTemplates RotaTemplate[]
  shiftOffers   ShiftOffer[]
  importSessions ImportSession[]
  agencyAddons   AgencyAddon[]
  auditEvents    AuditEvent[]
  clientContacts ClientContact[]
  clientRates    ClientRate[]
  assistConversations AssistConversation[]
  assistAutomations   AssistAutomation[]

  // Assist access policy: tool groups switched off for this agency, as
  // "<group>:read" or "<group>:write" (e.g. "payroll:write").
  assistDisabled String[] @default([])
  // Monthly Assist spend cap in US dollars (what the AI provider bills in).
  // Null uses ASSIST_MONTHLY_CAP_USD. Set by Pleasant, not by the agency.
  assistMonthlyCapUsd Int?
  assistUsage         AssistUsage[]

  // GOV.UK bank holiday calendar used for pay and charge premiums:
  // england-and-wales | scotland | northern-ireland
  bankHolidayDivision String @default("england-and-wales")

  integrations    Integration[]
  integrationLogs IntegrationLog[]
  smsMessages     SmsMessage[]
}

model User {
  id           String   @id @default(cuid())
  agencyId     String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(MANAGER)
  lastLoginAt  DateTime?
  // Bumped to revoke every outstanding session (password change, role change,
  // removal, "sign out everywhere"). Embedded in the signed session token.
  sessionVersion Int     @default(0)
  // Brute-force throttling: consecutive failed sign-ins and the lockout window.
  failedLoginCount Int   @default(0)
  lockedUntil  DateTime?
  // Null while active; set when an admin removes the user's access.
  deactivatedAt DateTime?
  // Their Aultrum ID ("sub"), once they've linked it by confirming their password.
  // One user per Aultrum ID is enforced when linking (lib/aultrum-signin.ts).
  aultrumSub   String?
  resetTokenHash String?
  resetTokenExpAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  staff     StaffProfile?
  approved  Timesheet[]   @relation("TimesheetApprover")
  createdShifts Shift[]   @relation("ShiftCreator")
  shiftComments ShiftComment[]
  verifiedRightToWork RightToWork[] @relation("RightToWorkVerifier")
  reviewedForms OnboardingForm[] @relation("FormReviewer")
  auditEvents AuditEvent[]
  assistConversations AssistConversation[]
  assistAutomations   AssistAutomation[]

  @@index([aultrumSub])
}

model StaffProfile {
  id          String      @id @default(cuid())
  agencyId    String
  userId      String?     @unique
  firstName   String
  lastName    String
  email       String?
  phone       String?
  jobTitle    String // e.g. "Care Assistant", "Registered Nurse", "Support Worker"
  band        String? // e.g. "Band 3", "Senior"
  status      StaffStatus @default(ACTIVE)

  // Engagement — PAYE workers go through payroll; Ltd workers are paid gross.
  engagementType String  @default("PAYE") // PAYE | LTD
  ltdCompanyName String?

  // Payroll identity
  niNumber         String? // stored encrypted-at-rest by the database in production
  taxCode          String  @default("1257L")
  studentLoanPlan  String? // NONE | PLAN_1 | PLAN_2 | PLAN_4 | PLAN_5 | POSTGRAD
  payBasis         PayBasis @default(HOURLY)

  // Rates (GBP)
  baseRate         Decimal  @db.Decimal(8, 2) @default(0)
  nightRate        Decimal? @db.Decimal(8, 2)
  weekendRate      Decimal? @db.Decimal(8, 2)
  bankHolidayRate  Decimal? @db.Decimal(8, 2)
  holidayAccrualPct Decimal @db.Decimal(5, 2) @default(12.07)

  pensionEnrolled  Boolean  @default(true)
  pensionEmployeePct Decimal @db.Decimal(4, 2) @default(5)
  pensionEmployerPct Decimal @db.Decimal(4, 2) @default(3)

  // Bank details (BACS payment files)
  bankName    String?
  accountName String?
  sortCode    String?
  bankAcct    String?

  // Compliance — disclosure & barring (care homes require it on file)
  dbsNumber String?
  dbsExpiry DateTime?

  startDate   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  shifts     Shift[]
  timesheets Timesheet[]
  payslips   Payslip[]
  shiftRequests ShiftRequest[]

  shiftComments ShiftComment[]
  documents     StaffDocument[]
  pushLogs      PushMessageLog[]
  complaints    ClientComplaint[]
  claimedCampaigns PushbotCampaign[]
  rightToWork   RightToWork?
  trainingRecords TrainingRecord[]
  onboardingForms OnboardingForm[]
  shiftOffers    ShiftOffer[]
  rotaTemplateLines RotaTemplateLine[]

  invoiceLines InvoiceLine[]


  @@index([agencyId, status])
}

enum ClientType {
  CARE_HOME
  NURSING_HOME
  DOMICILIARY_PROVIDER
  SUPPORTED_LIVING
  NHS
  LOCAL_AUTHORITY
  OTHER
}

// The organisation the agency supplies workers to and invoices: a care home,
// nursing home or domiciliary care provider. Its wards/units or branches are
// Sites; the people there (managers, signatories, accounts) are Contacts.
model Client {
  id               String       @id @default(cuid())
  agencyId         String
  // Organisation name as it appears on invoices. Nullable only until legacy
  // rows are backfilled (scripts/backfill-clients.ts); always written by the app.
  name             String?
  type             ClientType   @default(CARE_HOME)
  address          String?
  postcode         String?
  phone            String?
  email            String? // accounts / invoice email
  vatNumber        String?
  companyNo        String?
  cqcLocationId    String? // the home's own CQC registration, for compliance packs
  frameworkRef     String? // framework agreement / PO reference printed on invoices
  xeroContactId    String? // set once the client is created in the agency's Xero
  paymentTermsDays Int          @default(30)
  notes            String?
  status           ClientStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Legacy person-shaped fields from before clients were organisations.
  // Read only by the backfill; no longer written.
  firstName   String?
  lastName    String?
  companyName String?
  careLevel   String?

  agency   Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  shifts   Shift[]
  sites    Site[]
  contacts ClientContact[]
  rates    ClientRate[]

  pleasantLinkTokens PleasantLinkToken[]
  complaints         ClientComplaint[]
  confidenceRating   ClientConfidenceRating?

  invoices          Invoice[]
  rotaTemplateLines RotaTemplateLine[]

  @@index([agencyId, status])
}

// A person at a client: home manager, deputy, nurse in charge, accounts.
// Signatories can authorise timesheets through Pleasant Link.
model ClientContact {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  name        String
  jobTitle    String?
  email       String?
  phone       String?
  isSignatory Boolean  @default(false)
  isAccounts  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency             Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pleasantLinkTokens PleasantLinkToken[]

  @@index([clientId])
}

// Charge-out rate card: what the client pays per hour for a role, optionally
// specific to one site. Prefills the charge rate on new shifts.
model ClientRate {
  id              String   @id @default(cuid())
  agencyId        String
  clientId        String
  siteId          String?
  role            String // e.g. "Care Assistant", "Senior Carer", "Registered Nurse"
  dayRate         Decimal  @db.Decimal(8, 2)
  nightRate       Decimal? @db.Decimal(8, 2)
  weekendRate     Decimal? @db.Decimal(8, 2)
  bankHolidayRate Decimal? @db.Decimal(8, 2)
  sleepInCharge   Decimal? @db.Decimal(8, 2) // flat client charge per sleep-in
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// A ward/unit of a care home, or a branch of a domiciliary provider.
model Site {
  id        String   @id @default(cuid())
  agencyId  String
  clientId  String?
  name      String
  address   String?
  postcode  String?
  notes     String? // arrival, parking, door codes
  createdAt DateTime @default(now())

  agency            Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  rotaTemplateLines RotaTemplateLine[]
  rates             ClientRate[]

  @@index([agencyId])
  @@index([clientId])
}

model Shift {
  id              String  @id @default(cuid())
  agencyId        String
  clientId        String?
  siteId          String?
  staffId         String?
  createdById     String?
  rotaTemplateId  String?

  title     String // e.g. "Morning care call", "Night shift — Ward 4"
  role      String // required role for the shift
  startAt   DateTime
  endAt     DateTime
  breakMins Int         @default(0)

  // Charge-out rate to the client (agency revenue). Pay comes from the staff profile.
  chargeRate Decimal @db.Decimal(8, 2) @default(0)

  // Sleep-in shifts are paid a flat allowance rather than an hourly rate.
  isSleepIn    Boolean @default(false)
  sleepInRate  Decimal @db.Decimal(8, 2) @default(0)
  // What the client is charged for a sleep-in. Null bills the carer allowance.
  sleepInCharge Decimal? @db.Decimal(8, 2)

  status    ShiftStatus @default(DRAFT)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site          Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  staff         StaffProfile?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("ShiftCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rotaTemplate  RotaTemplate?  @relation(fields: [rotaTemplateId], references: [id], onDelete: SetNull)
  timesheet     Timesheet?
  shiftRequests ShiftRequest[]
  shiftOffers   ShiftOffer[]

  comments         ShiftComment[]
  complaints       ClientComplaint[]
  pushbotCampaigns PushbotCampaign[]

  invoiceLines InvoiceLine[]

  @@index([agencyId, startAt])
  @@index([agencyId, status])
  @@index([staffId, startAt])
  @@index([rotaTemplateId])
}

model ShiftRequest {
  id        String   @id @default(cuid())
  agencyId  String
  shiftId   String
  staffId   String
  message   String?

  status    ShiftRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  agency Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  shift  Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([shiftId, staffId])
  @@index([agencyId, status])
  @@index([staffId, status])
}

model Timesheet {
  id        String          @id @default(cuid())
  agencyId  String
  shiftId   String          @unique
  staffId   String

  clockIn   DateTime
  clockOut  DateTime?
  breakMins Int             @default(0)
  workedMins Int            @default(0)

  status      TimesheetStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  notes        String?

  // Expenses claimed on this timesheet (mileage/travel — non-taxable).
  expenses     Decimal @db.Decimal(10, 2) @default(0)
  expenseNotes String?

  // Candidate (carer) e-signature signing off the hours.
  candidateSignature String?
  candidateSignedAt  DateTime?

  // Client authorisation (care-home signatory confirming role + hours).
  clientAuthName      String?
  clientAuthPosition  String?
  clientAuthAt        DateTime?
  clientAuthSignature String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency   Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  shift    Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff    StaffProfile  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("TimesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  invoiceLines InvoiceLine[]

  @@index([agencyId, status])
  @@index([staffId, clockIn])
}

model PayrollRun {
  id         String        @id @default(cuid())
  agencyId   String
  reference  String // e.g. "2026-09-M1"
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  taxYear     String // e.g. "2026/27"
  status      PayrollStatus @default(DRAFT)

  grossTotal   Decimal @db.Decimal(12, 2) @default(0)
  payeTotal    Decimal @db.Decimal(12, 2) @default(0)
  niTotal      Decimal @db.Decimal(12, 2) @default(0)
  pensionTotal Decimal @db.Decimal(12, 2) @default(0)
  netTotal     Decimal @db.Decimal(12, 2) @default(0)
  employerNiTotal Decimal @db.Decimal(12, 2) @default(0)

  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([agencyId, reference])
  @@index([agencyId, status])
}

model Payslip {
  id           String   @id @default(cuid())
  payrollRunId String
  staffId      String
  timesheetHours Decimal @db.Decimal(8, 2) @default(0)

  grossPay      Decimal @db.Decimal(12, 2) @default(0)
  holidayPay    Decimal @db.Decimal(12, 2) @default(0)
  expenses      Decimal @db.Decimal(12, 2) @default(0)
  taxablePay    Decimal @db.Decimal(12, 2) @default(0)
  paye          Decimal @db.Decimal(12, 2) @default(0)
  niEmployee    Decimal @db.Decimal(12, 2) @default(0)
  pensionEmployee Decimal @db.Decimal(12, 2) @default(0)
  pensionEmployer Decimal @db.Decimal(12, 2) @default(0)
  studentLoan   Decimal @db.Decimal(12, 2) @default(0)
  otherDeductions Decimal @db.Decimal(12, 2) @default(0)
  employerNi    Decimal @db.Decimal(12, 2) @default(0)
  netPay        Decimal @db.Decimal(12, 2) @default(0)

  taxCode    String
  niNumber   String?
  createdAt  DateTime @default(now())

  payrollRun PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  lines      PayslipLine[]

  @@unique([payrollRunId, staffId])
  @@index([staffId])
}

model PayslipLine {
  id        String   @id @default(cuid())
  payslipId String
  type      LineType
  label     String
  quantity  Decimal? @db.Decimal(8, 2)
  rate      Decimal? @db.Decimal(8, 4)
  amount    Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}


model ShiftComment {
  id        String   @id @default(cuid())
  agencyId  String
  shiftId   String
  staffId   String?
  userId    String?
  comment   String
  createdAt DateTime @default(now())

  agency Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  shift  Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff  StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shiftId])
}

model StaffDocument {
  id          String    @id @default(cuid())
  agencyId    String
  staffId     String
  title       String    // e.g. "Agency Term Sheet 2026", "Working Time Directive Opt-Out"
  documentUrl String?
  signature   String?   // Base64 or digital signature token
  signedAt    DateTime?
  status      String    @default("PENDING") // PENDING | SIGNED | EXPIRED
  createdAt   DateTime  @default(now())

  agency Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
}

// -----------------------------------------------------------------------------
// RECRUITMENT & COMPLIANCE
// -----------------------------------------------------------------------------

model RightToWork {
  id              String   @id @default(cuid())
  agencyId        String
  staffId         String   @unique
  documentType    String   // PASSPORT | BRP | SHARE_CODE | BIRTH_CERTIFICATE
  documentNumber  String?
  issueDate       DateTime?
  expiryDate      DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  documentUrl     String?
  status          String   @default("PENDING") // PENDING | VERIFIED | EXPIRED | REJECTED

  agency   Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation("RightToWorkVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([agencyId, status])
}

model TrainingRecord {
  id              String   @id @default(cuid())
  agencyId        String
  staffId         String
  courseName      String   // e.g., "Manual Handling", "Basic Life Support"
  provider        String?
  completedAt     DateTime?
  expiryDate      DateTime?
  certificateUrl  String?
  status          String   @default("PENDING") // PENDING | COMPLETED | EXPIRED

  agency Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
}

model OnboardingForm {
  id              String   @id @default(cuid())
  agencyId        String
  staffId         String
  formType        String   // MEDICAL | BANKING | REFERENCE | GENERAL
  payload         String?  // JSON data of the form answers
  status          String   @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?

  agency     Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  staff      StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("FormReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([staffId, status])
}


model PushMessageLog {
  id          String   @id @default(cuid())
  agencyId    String
  staffId     String
  channel     String   // WHATSAPP | SMS | IMESSAGE
  direction   String   // OUTBOUND | INBOUND
  content     String
  status      String   @default("SENT") // SENT | DELIVERED | READ | FAILED
  aiAgentId   String?  // ID of the Push AI Agent handling the conversation
  externalId  String?  // Twilio / Meta Message ID
  createdAt   DateTime @default(now())

  agency Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([agencyId, staffId])
}

// -----------------------------------------------------------------------------
// CLIENTPOINT (CRM via Pleasant Link)
// -----------------------------------------------------------------------------

model PleasantLinkToken {
  id        String    @id @default(cuid())
  agencyId  String
  clientId  String
  // The signatory this link was issued to; sign-offs are recorded in their name.
  contactId String?
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  agency  Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client  Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([token])
}

model ClientComplaint {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  shiftId     String?
  staffId     String?
  category    String   // LATE_ARRIVAL | NO_SHOW | ATTITUDE | DRESS_CODE | GENERAL
  description String
  severity    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String   @default("OPEN") // OPEN | INVESTIGATING | RESOLVED | DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shift  Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  staff  StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([agencyId, clientId])
}

model ClientConfidenceRating {
  id              String   @id @default(cuid())
  agencyId        String
  clientId        String   @unique
  score           Decimal  @db.Decimal(3, 2) @default(5.00) // 1.00 to 5.00
  cancellationPct Decimal  @db.Decimal(5, 2) @default(0)
  promptPaymentPct Decimal @db.Decimal(5, 2) @default(100.0)
  siteSafetyScore Decimal  @db.Decimal(3, 2) @default(5.00)
  updatedAt       DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// AGENTS (Pushbots, Consult, Runners, Logs)
// -----------------------------------------------------------------------------

model AgentTask {
  id          String   @id @default(cuid())
  agencyId    String
  agentType   String   // RUNNERS | CONSULT | PUSHBOTS
  title       String
  payload     String?  // JSON formatted parameters
  status      String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  assignedTo  String?  // User or Staff ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
}

model AgentLog {
  id          String   @id @default(cuid())
  agencyId    String
  agentName   String   // PUSHBOTS | CONSULT | RUNNERS
  action      String   // e.g. "TRIAGE_SHIFT_UNATTENDED", "EXECUTE_RUNNER_TASK"
  details     String   // Full log detail or JSON
  status      String   @default("SUCCESS") // SUCCESS | WARNING | ERROR
  createdAt   DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, agentName])
}

model PushbotCampaign {
  id           String   @id @default(cuid())
  agencyId     String
  shiftId      String
  targetRole   String
  channel      String   @default("WHATSAPP") // WHATSAPP | SMS | SLACK
  status       String   @default("RUNNING") // RUNNING | COMPLETED | EXPIRED | CANCELLED
  offersSent   Int      @default(0)
  claimedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  shift  Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  claimedBy StaffProfile? @relation(fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([agencyId, status])
}



model Invoice {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String
  reference   String
  periodStart DateTime
  periodEnd   DateTime
  issueDate   DateTime?
  dueDate     DateTime?
  paidAt      DateTime?
  status      InvoiceStatus @default(DRAFT)

  hoursTotal  Decimal @db.Decimal(10, 2) @default(0)
  chargeTotal Decimal @db.Decimal(12, 2) @default(0)
  payTotal    Decimal @db.Decimal(12, 2) @default(0)
  marginTotal Decimal @db.Decimal(12, 2) @default(0)
  vatRatePct  Decimal @db.Decimal(5, 2) @default(0)
  vatTotal    Decimal @db.Decimal(12, 2) @default(0)
  grandTotal  Decimal @db.Decimal(12, 2) @default(0)

  notes    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Live Xero sync: the invoice's id in Xero and when Pleasant last sent it.
  xeroInvoiceId String?
  xeroStatus    String? // status Pleasant last saw in Xero: DRAFT | AUTHORISED | PAID | VOIDED | DELETED
  xeroSyncedAt  DateTime?

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines  InvoiceLine[]

  @@unique([agencyId, reference])
  @@index([agencyId, status])
  @@index([clientId, periodStart])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  timesheetId String?
  shiftId     String?
  staffId     String

  date       DateTime
  title      String
  hours      Decimal @db.Decimal(8, 2)
  chargeRate Decimal @db.Decimal(8, 2) @default(0)
  chargeAmount Decimal @db.Decimal(12, 2)
  payAmount    Decimal @db.Decimal(12, 2)
  marginAmount Decimal @db.Decimal(12, 2)

  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timesheet Timesheet?    @relation(fields: [timesheetId], references: [id], onDelete: SetNull)
  shift     Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  staff     StaffProfile  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([staffId, date])
}

model RotaTemplate {
  id        String   @id @default(cuid())
  agencyId  String
  title     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lines  RotaTemplateLine[]
  shifts Shift[]

  @@index([agencyId])
}

model RotaTemplateLine {
  id          String @id @default(cuid())
  templateId  String
  weekday     Int // 0 = Sunday … 6 = Saturday (ISO-like for calendar rendering)
  role        String
  title       String
  startMins   Int // minutes since midnight
  endMins     Int
  breakMins   Int @default(0)
  isSleepIn   Boolean @default(false)
  sleepInRate Decimal @db.Decimal(8, 2) @default(0)
  // What the client is charged for a sleep-in. Null bills the carer allowance.
  sleepInCharge Decimal? @db.Decimal(8, 2)
  chargeRate  Decimal @db.Decimal(8, 2) @default(0)
  clientId    String?
  staffId     String?
  siteId      String?

  template RotaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  client   Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  staff    StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  site     Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

model ShiftOffer {
  id          String           @id @default(cuid())
  agencyId    String
  shiftId     String
  staffId     String
  status      ShiftOfferStatus @default(OFFERED)
  offeredAt   DateTime         @default(now())
  respondedAt DateTime?
  note        String?

  agency Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  shift  Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staff  StaffProfile  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([shiftId, staffId])
  @@index([staffId, status])
  @@index([agencyId, status])
}

// -----------------------------------------------------------------------------
// CSV IMPORT (migration from spreadsheets and legacy systems)
// -----------------------------------------------------------------------------

model ImportSession {
  id          String   @id @default(cuid())
  agencyId    String
  kind        String // CLIENTS | WORKERS | SHIFTS
  headers     String // JSON array of column headers
  payload     String // raw CSV text as uploaded
  totalRows   Int      @default(0)
  createdRows Int      @default(0)
  skippedRows Int      @default(0)
  status      String   @default("PENDING") // PENDING | COMPLETED
  completedAt DateTime?
  createdAt   DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
}

model AgencyAddon {
  id          String    @id @default(cuid())
  agencyId    String
  key         AddonKey
  installed   Boolean   @default(false)
  active      Boolean   @default(true) // purchased/entitled
  expiresAt   DateTime?
  installedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, key])
  @@index([agencyId])
}




// Append-only trail of security-relevant and money-moving actions. Never
// updated or deleted by the app; actor details are denormalised so the trail
// survives the actor's removal.
model AuditEvent {
  id         String   @id @default(cuid())
  agencyId   String
  actorId    String?
  actorEmail String?
  action     String // dotted verb, e.g. "payroll.finalise", "team.role_change"
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([agencyId, action])
}

// An Assist conversation. Private to the user who started it. The server
// holds the authoritative Messages API history; the browser only ever sends
// the next message or its decisions on pending changes.
model AssistConversation {
  id           String   @id @default(cuid())
  agencyId     String
  userId       String
  title        String
  messages     Json     @default("[]")
  // Plain-English confirmation summaries, keyed by tool_use id.
  summaries    Json     @default("{}")
  pinned       Boolean  @default(false)
  automationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation AssistAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([automationId, createdAt])
}

// A scheduled Assist prompt. Runs unattended with read-only tools; each run
// is saved as a conversation and can be emailed to the owner.
model AssistAutomation {
  id          String    @id @default(cuid())
  agencyId    String
  userId      String
  name        String
  prompt      String
  cadence     String // DAILY | WEEKDAYS | WEEKLY
  weekday     Int? // 0 = Sunday … 6 = Saturday, for WEEKLY
  time        String // "HH:MM", UK time
  enabled     Boolean   @default(true)
  emailResult Boolean   @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastStatus  String? // OK | FAILED
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs   AssistConversation[]

  @@index([enabled, nextRunAt])
  @@index([userId])
}

// Assist model usage per person per month (UK calendar month, "2026-10").
// Cost is estimated from list prices, in millionths of a US dollar.
model AssistUsage {
  agencyId         String
  userId           String
  month            String
  requests         Int      @default(0)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMicros       Int      @default(0)
  updatedAt        DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@id([agencyId, month, userId])
}

enum IntegrationStatus {
  CONNECTED
  ERROR // connected, but the last call failed (e.g. expired access)
}

// A live connection from one agency to an outside service (Xero, Twilio...).
// Disconnecting deletes the row and its credentials.
model Integration {
  id            String            @id @default(cuid())
  agencyId      String
  provider      String // key from lib/integrations/catalog.ts
  status        IntegrationStatus @default(CONNECTED)
  // Non-secret settings shown in the app, e.g. the SMS sender or Xero organisation.
  config        Json              @default("{}")
  // Credentials and tokens: AES-256-GCM encrypted JSON (lib/integrations/crypto.ts).
  secrets       String?
  connectedById String?
  lastSyncAt    DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  agency Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  logs   IntegrationLog[]

  @@unique([agencyId, provider])
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String?
  agencyId      String
  provider      String
  action        String // e.g. "test", "sync", "sms.out", "sms.in"
  ok            Boolean
  detail        String
  createdAt     DateTime @default(now())

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([agencyId, provider, createdAt])
}

// Bank holidays from the GOV.UK feed, refreshed daily by the integrations job.
// The payroll engine also has a built-in list as a fallback.
model BankHoliday {
  division String // england-and-wales | scotland | northern-ireland
  date     String // YYYY-MM-DD
  title    String

  @@id([division, date])
}

// Text messages to and from carers, e.g. shift offers answered by reply.
model SmsMessage {
  id         String   @id @default(cuid())
  agencyId   String
  staffId    String?
  offerId    String?
  direction  String // OUT | IN
  phone      String // the carer's number, E.164
  body       String
  // OUT shift offers: the code a carer can reply with ("YES 4821").
  code       String?
  providerId String? // Twilio message SID
  status     String // SENT | FAILED | RECEIVED
  createdAt  DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, phone, createdAt])
}

// Last time a background job checked in (e.g. "assist-scheduler"), so the
// app can show whether its scheduler is actually running.
model SystemHeartbeat {
  key    String   @id
  at     DateTime
  detail String?
}
