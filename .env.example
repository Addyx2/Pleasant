# Pleasant — shift scheduling and payroll for UK healthcare agencies.

# Postgres (local Docker or Vercel Postgres / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pleasant?schema=public"

# Session signing secret (min 32 chars). Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# AI (optional — shift-fill suggestions, payroll anomaly explanations)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_NAME="Pleasant"
