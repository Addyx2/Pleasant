# Pleasant — shift scheduling and payroll for UK healthcare agencies.

# Postgres (local Docker or Vercel Postgres / Neon). Use a pooled URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pleasant?schema=public"

# Session signing secret (min 32 chars). Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL used in emailed links (invites, password resets).
# Falls back to the request host when unset.
APP_URL=

# Transactional email via Resend. Without a key, invite/reset links are shown
# on screen for the admin to copy instead of being emailed.
RESEND_API_KEY=
EMAIL_FROM="Pleasant <no-reply@yourdomain.co.uk>"

# Show demo credentials on the sign-in page. Always on in development; set to
# "true" only on a public demo deployment, never on a customer instance.
NEXT_PUBLIC_DEMO_MODE=

# Assist, the in-app AI assistant (Claude Opus 5.5 via the Anthropic API).
# Without a key the Assist panel explains that it isn't set up.
ANTHROPIC_API_KEY=
# Monthly Assist spend cap per agency, in US dollars (estimated from list
# prices). Assist and its automations pause for the agency once it's reached,
# until the 1st of the next month. Defaults to 50. Override one agency by
# setting Agency.assistMonthlyCapUsd.
ASSIST_MONTHLY_CAP_USD=

# Integrations (Settings → Integrations).
# Encrypts each agency's integration credentials at rest. 32 random bytes,
# base64: openssl rand -base64 32. If unset, a key is derived from AUTH_SECRET.
# Changing it means agencies must reconnect their integrations.
INTEGRATIONS_KEY=
# Pleasant's Xero app (developer.xero.com → My Apps, a "Web app"). Set its
# redirect URI to <APP_URL>/api/integrations/xero/callback. Without these the
# Xero card says Xero isn't available yet.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional: override the OAuth scopes requested (granular scopes by default).
XERO_SCOPES=
# SMS needs nothing here: each agency connects its own Twilio account. Replies
# arrive at /api/webhooks/twilio/<id>, which must be reachable over HTTPS.

# Shared secret for the Assist automations scheduler (GET /api/cron/assist).
# At least 16 characters; generate with: openssl rand -hex 32. Also set it, with APP_URL, as GitHub
# repository secrets so .github/workflows/assist-automations.yml can call it.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_NAME="Pleasant"
